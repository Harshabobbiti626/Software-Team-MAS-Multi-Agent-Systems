# ==============================================================================
# MAS (Multi-Agent System) - Environment Variables & AI Model Configuration
# Copy this file to .env and configure your desired AI provider.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI (Default)
# Models: gemini-2.5-pro, gemini-2.5-flash, gemini-3.0-thinking
# Get API Key: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. OPENAI / CHATGPT
# Models: gpt-4o, gpt-4o-mini, o3-mini, o1
# Get API Key: https://platform.openai.com/api-keys
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=your_openai_api_key_here
# MAS_LLM_PROVIDER=openai

# ------------------------------------------------------------------------------
# 3. ANTHROPIC CLAUDE
# Models: claude-3-7-sonnet-20250219, claude-3-5-sonnet-20241022, claude-3-5-haiku
# Get API Key: https://console.anthropic.com/settings/keys
# ------------------------------------------------------------------------------
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# MAS_LLM_PROVIDER=anthropic

# ------------------------------------------------------------------------------
# 4. LOCAL MODELS / OLLAMA (OpenAI-Compatible, No Cost, 100% Offline)
# Recommended local models: qwen2.5-coder:14b, deepseek-r1:14b, llama3.3:70b
# Setup: Run `ollama run qwen2.5-coder:14b`
# ------------------------------------------------------------------------------
# MAS_LLM_PROVIDER=ollama
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1

# ------------------------------------------------------------------------------
# 5. GROQ (Ultra-Fast Inference)
# Models: llama-3.3-70b-versatile, deepseek-r1-distill-llama-70b
# Get API Key: https://console.groq.com/keys
# ------------------------------------------------------------------------------
# MAS_LLM_PROVIDER=groq
# OPENAI_API_KEY=gsk_your_groq_key_here
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# ------------------------------------------------------------------------------
# 6. DEEPSEEK
# Models: deepseek-chat, deepseek-reasoner
# Get API Key: https://platform.deepseek.com/
# ------------------------------------------------------------------------------
# MAS_LLM_PROVIDER=deepseek
# OPENAI_API_KEY=your_deepseek_key_here
# OPENAI_BASE_URL=https://api.deepseek.com/v1

# ------------------------------------------------------------------------------
# 7. SYSTEM & REPOSITORY LIMITS
# ------------------------------------------------------------------------------
MAS_ENVIRONMENT=development
MAS_LOG_LEVEL=INFO
