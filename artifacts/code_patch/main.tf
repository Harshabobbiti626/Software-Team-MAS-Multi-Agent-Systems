# Terraform IaC for Integration Test Service
# Generated by CloudEngineerAgent
# Service Slug: integration-test-service
# Enforces Least-Privilege IAM & Encrypted Storage

terraform {
  required_version = ">= 1.5.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

resource "aws_kms_key" "service_key" {
  description             = "Dedicated KMS key for integration-test-service encryption"
  deletion_window_in_days = 30
  enable_key_rotation     = true
  tags = {
    Environment = "production"
    ManagedBy   = "MAS"
    Service     = "integration-test-service"
  }
}

resource "aws_security_group" "service_sg" {
  name        = "sg-integration-test-service"
  description = "Strict least-privilege security group for integration-test-service"

  ingress {
    description = "HTTPS ingress from internal VPC"
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["10.0.0.0/16"]
  }

  egress {
    description = "Strict HTTPS egress for external API integration"
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name    = "sg-integration-test-service"
    Service = "integration-test-service"
  }
}
