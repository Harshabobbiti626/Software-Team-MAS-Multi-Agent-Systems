# Terraform IaC for Real-Time Payment Gateway
# Generated by CloudEngineerAgent
# Enforces Least-Privilege IAM & Encrypted Storage

terraform {
  required_version = ">= 1.5.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

resource "aws_kms_key" "service_key" {
  description             = "KMS key for TASK-001"
  deletion_window_in_days = 30
  enable_key_rotation     = true
}

resource "aws_security_group" "service_sg" {
  name        = "sg-task-001"
  description = "Strict least-privilege security group for Real-Time Payment Gateway"

  ingress {
    description = "HTTPS ingress"
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["10.0.0.0/16"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}
